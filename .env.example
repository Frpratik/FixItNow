# FixItNow Environment Configuration

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/fixitnow
POSTGRES_DB=fixitnow
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Security & JWT
JWT_SECRET=super-secret-jwt-key-fixitnow-production-grade-random-hex-string-32+chars
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7

# Matching Engine Configuration
MAX_RADIUS_KM=10.0
FIRST_WAVE_SIZE=5
FIRST_WAVE_TIMEOUT_SEC=60
EXPIRY_TIMEOUT_MIN=5

# Logging & Environment
LOG_LEVEL=INFO
ENVIRONMENT=development

# Network Ports
API_PORT=8000
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
